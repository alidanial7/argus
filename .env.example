# General
TZ=Asia/Tehran
COMPOSE_PROJECT_NAME=ai-stack

# Domains (Nginx server_name — use *.localhost for local HTTP)
DOMAIN_WEBUI=webui.localhost
DOMAIN_N8N=n8n.localhost
DOMAIN_SEARXNG=search.localhost
DOMAIN_QDRANT=qdrant.localhost

# PostgreSQL
POSTGRES_USER=argus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=argus

# Redis
REDIS_PASSWORD=changeme

# n8n
N8N_HOST=n8n.localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=changeme-generate-a-long-random-string
WEBHOOK_URL=http://n8n.localhost/

# Open WebUI
WEBUI_SECRET_KEY=changeme-generate-a-long-random-string

# Ollama
OLLAMA_KEEP_ALIVE=30m

# Qdrant
QDRANT__SERVICE__API_KEY=changeme

# SearXNG (also set server.secret_key in searxng/settings.yml)
SEARXNG_BASE_URL=http://search.localhost/
